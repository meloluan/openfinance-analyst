# Credenciais da aplicação criada em https://dashboard.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# IDs das conexões criadas em https://meu.pluggy.ai (separados por vírgula).
# O SDK não permite listar conexões, então elas precisam ser declaradas uma vez.
# Depois do primeiro sync ficam persistidas no banco local.
PLUGGY_ITEM_IDS=

# Opcional — default é ~/.openfinance-analyst
# OFA_DATA_DIR=
